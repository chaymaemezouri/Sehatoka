# Adapter de conversation.
# "demo" = moteur local déterministe (par défaut). Une future valeur "remote"
# pourra pointer vers un backend LLM / multi-agents sans modifier l'interface.
VITE_CHAT_ADAPTER=demo

# Réservé à l'intégration future. Ne pas renseigner d'endpoint tiers
# tant que le backend n'est pas disponible — la démo n'émet aucune requête réseau.
# VITE_CHAT_API_URL=

# Comptes.
# "api" appelle le service Sehatoka sur /api. C'est le seul mode à utiliser pour un build public.
# Un build de production ignore "demo". En développement, l'absence de valeur garde le mode local.
# VITE_AUTH_MODE=api

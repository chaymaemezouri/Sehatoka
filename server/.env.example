# Base dédiée à Sehatoka. Ne pas réutiliser la base d'une autre application.
# PostgreSQL doit écouter uniquement sur 127.0.0.1.
# Côté PostgreSQL : log_statement=none et log_min_error_statement=panic,
# afin qu'un e-mail ou un champ de santé n'apparaisse pas dans le journal du moteur.
DATABASE_URL=postgresql://sehatoka:change-me@127.0.0.1:5432/sehatoka

# Origines autorisées pour les requêtes qui déposent un cookie de session.
APP_ORIGINS=https://sehatoka.academyskills.net

# Poivre local pour les compteurs de tentatives. Valeur longue et aléatoire.
ATTEMPT_PEPPER=change-me-to-a-long-random-string

PORT=3001
HOST=127.0.0.1
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_HOURS=12

# La réinitialisation reste fermée tant que l'envoi SMTP n'a pas été configuré et testé.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
